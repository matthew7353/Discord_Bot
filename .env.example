# Ta sama connection string co w bot.js (ten sam Storage Account / kontener audio-files)
AZURE_STORAGE_CONNECTION_STRING=

# Ollama (opcjonalnie, mają sensowne wartości domyślne)
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL_NAME=gemma4:31b-cloud

# Ustaw na "false" tylko podczas debugowania, żeby maszyna się sama nie wyłączała
ORCHESTRATOR_AUTO_SHUTDOWN=true

# Kasuje surowe .pcm z blob storage (i lokalne kopie) zaraz po udanym
# przetworzeniu sesji - to największy koszt storage w tym kontenerze.
# Ustaw na "false" jeśli chcesz zachować nagrania (np. do ręcznej weryfikacji).
ORCHESTRATOR_CLEANUP_AUDIO=true
