# Ta sama connection string co w bot.js (ten sam Storage Account / kontener audio-files)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=audio-files

# Lokalna Ollama (w kontenerze startuje ją entrypoint.sh)
OLLAMA_HOST_URL=http://127.0.0.1:11434
OLLAMA_MODEL_NAME=gemma4:31b
OLLAMA_NUM_CTX=16384
OLLAMA_TEMPERATURE=0.3
# OLLAMA_THINK=true

# Whisper (w obrazie ustawiane przy budowaniu)
WHISPER_MODEL=large-v3

# Kasuje surowe .pcm z blob storage zaraz po udanym przetworzeniu sesji -
# to największy koszt storage w tym kontenerze.
# Ustaw na "false" jeśli chcesz zachować nagrania (np. do ręcznej weryfikacji).
ORCHESTRATOR_CLEANUP_AUDIO=true
