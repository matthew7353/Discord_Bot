# Istniejące
DISCORD_TOKEN=
AZURE_STORAGE_CONNECTION_STRING=
# Musi być taki sam jak AZURE_STORAGE_CONTAINER w jobie (branch azure-job)
AZURE_STORAGE_CONTAINER=audio-files

# Uruchamianie Azure Container Apps Job, który robi transkrypcję i notatki
# (obraz z brancha azure-job). Ta maszyna ma System-Assigned Managed Identity
# z rolą na jobie pozwalającą go startować i czytać wykonania (np. "Contributor"
# scoped na job) - żadnych sekretów tu nie potrzeba.
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
AZURE_PROCESSING_JOB_NAME=dnd-notes-job
