[Unit]
Description=DnD session orchestrator (transcribe + notes)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Dostosuj ścieżki i użytkownika do swojej instalacji.
User=azureuser
WorkingDirectory=/home/azureuser/discord_bot
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/home/azureuser/discord_bot/.env
ExecStart=/home/azureuser/discord_bot/venv/bin/python /home/azureuser/discord_bot/orchestrator.py
# Jeśli coś wywali wyjątkiem poza tym co orchestrator sam łapie, nie zapętlaj w kółko:
Restart=no
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
